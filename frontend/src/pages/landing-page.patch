+        opacity: 0;
+        animation: ccFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
+      }
+
+      @keyframes ccDrift {
+        0%, 100% { transform: translate3d(0, 0, 0); }
+        50% { transform: translate3d(0, -16px, 0); }
+      }
+      .cc-orb {
+        position: absolute;
+        border-radius: 50%;
+        filter: blur(60px);
